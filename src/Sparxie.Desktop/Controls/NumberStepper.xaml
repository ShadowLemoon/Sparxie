<UserControl
    x:Class="Sparxie.Desktop.Controls.NumberStepper"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="DecButton" Width="48" Height="48" Padding="0" Click="OnDecrement"
                AutomationProperties.Name="减少">
            <FontIcon Glyph="&#xE738;" FontSize="14" />
        </Button>
        <NumberBox x:Name="Box" Width="96" MinHeight="48" FontSize="18" Padding="8,11,8,9"
                   SpinButtonPlacementMode="Hidden" ValidationMode="InvalidInputOverwritten"
                   ValueChanged="OnBoxValueChanged" />
        <Button x:Name="IncButton" Width="48" Height="48" Padding="0" Click="OnIncrement"
                AutomationProperties.Name="增加">
            <FontIcon Glyph="&#xE710;" FontSize="14" />
        </Button>
    </StackPanel>
</UserControl>
