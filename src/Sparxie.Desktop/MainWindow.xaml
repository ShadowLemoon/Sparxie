<Window
    x:Class="Sparxie.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Sparxie.Desktop.Views">
    <Grid x:Name="Root" Background="#111315">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Image x:Name="WindowBackground" Grid.RowSpan="2" Stretch="UniformToFill" Visibility="Collapsed" />
        <Rectangle Grid.RowSpan="2">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop Color="#99000000" Offset="0" />
                    <GradientStop Color="#33000000" Offset="0.1" />
                    <GradientStop Color="#00000000" Offset="0.18" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Grid.Row="0">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B3000000" Offset="0" />
                    <GradientStop Color="#4D000000" Offset="0.5" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Profile 页遮罩：跨全窗（含标题栏区域）保证上下深色一致，且位于标题栏之下不挡点击。 -->
        <Grid x:Name="ProfilesLayer" Grid.RowSpan="2"
              Visibility="{Binding IsProfilesVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#C2111315">
            <views:ProfileManagerPage Margin="0,48,0,0" />
        </Grid>

        <Grid x:Name="AppTitleBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center">
                <Button Width="40" Height="40" Command="{Binding ShowHomeCommand}"
                        Visibility="{Binding IsProfilesVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTipService.ToolTip="返回主页" AutomationProperties.Name="返回主页">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <FontIcon Glyph="&#xE768;" FontSize="15" />
                <TextBlock Text="Sparxie" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,146,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{Binding IsHomeChromeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Width="40" Height="40" Command="{Binding ShowProfilesCommand}"
                        ToolTipService.ToolTip="Profile 管理" AutomationProperties.Name="Profile 管理">
                    <FontIcon Glyph="&#xE77B;" FontSize="16" />
                </Button>
                <Button Width="40" Height="40" Command="{Binding ToggleSettingsCommand}"
                        ToolTipService.ToolTip="应用设置" AutomationProperties.Name="应用设置">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid x:Name="HomeLayer"
                  Visibility="{Binding IsHomeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <views:HomePage />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Margin="0,12,0,0"
                        Visibility="{Binding IsHomeChromeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <ToggleButton x:Name="TabGenshin" Style="{StaticResource PillTabStyle}" Tag="Genshin"
                              Checked="OnGameTabChecked" ToolTipService.ToolTip="原神"
                              AutomationProperties.Name="游戏标签 原神">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image x:Name="IconGenshin" Width="26" Height="26" VerticalAlignment="Center" />
                        <TextBlock Text="原神" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="TabStarRail" Style="{StaticResource PillTabStyle}" Tag="StarRail"
                              Checked="OnGameTabChecked" ToolTipService.ToolTip="星穹铁道"
                              AutomationProperties.Name="游戏标签 星穹铁道">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image x:Name="IconStarRail" Width="26" Height="26" VerticalAlignment="Center" />
                        <TextBlock Text="星穹铁道" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="TabZenlessZoneZero" Style="{StaticResource PillTabStyle}" Tag="ZenlessZoneZero"
                              Checked="OnGameTabChecked" ToolTipService.ToolTip="绝区零"
                              AutomationProperties.Name="游戏标签 绝区零">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image x:Name="IconZenlessZoneZero" Width="26" Height="26" VerticalAlignment="Center" />
                        <TextBlock Text="绝区零" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- 遮罩用 Border（无 hover 视觉态）：Button 的 PointerOver 会让整块遮罩连带左侧一起变暗。 -->
        <Border Grid.RowSpan="2" Background="#59000000"
                Tapped="OnScrimTapped"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                AutomationProperties.Name="关闭设置" />
        <views:SettingsDrawer Grid.RowSpan="2" HorizontalAlignment="Right"
                              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</Window>
