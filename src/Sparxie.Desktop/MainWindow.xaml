<Window
    x:Class="Sparxie.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Sparxie.Desktop.Views">
    <Grid x:Name="Root" Background="#111315" IsTabStop="True" PreviewKeyDown="OnRootPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Image x:Name="WindowBackground" Grid.RowSpan="2" Stretch="UniformToFill" Visibility="Collapsed" />
        <Image x:Name="WindowBackgroundFade" Grid.RowSpan="2" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" />
        <Rectangle Grid.RowSpan="2">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop Color="#99000000" Offset="0" />
                    <GradientStop Color="#33000000" Offset="0.1" />
                    <GradientStop Color="#00000000" Offset="0.18" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Grid.Row="0">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC000000" Offset="0" />
                    <GradientStop Color="#66000000" Offset="0.5" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Profile 页遮罩：跨全窗（含标题栏区域）保证上下深色一致，且位于标题栏之下不挡点击。 -->
        <Grid x:Name="ProfilesLayer" Grid.RowSpan="2"
              Visibility="{Binding IsProfilesVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#B3111315">
            <views:ProfileManagerPage Margin="0,48,0,0" />
        </Grid>

        <Grid x:Name="AppTitleBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE768;" FontSize="15" />
                <TextBlock Text="Sparxie" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,0,176,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{Binding IsHomeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Width="44" Height="44" Padding="0" CornerRadius="22" Background="{StaticResource GlassOverlayBrush}"
                        BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1"
                        Command="{Binding ToggleSettingsCommand}"
                        ToolTipService.ToolTip="应用设置" AutomationProperties.Name="应用设置">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid x:Name="HomeLayer"
                  Visibility="{Binding IsHomeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <views:HomePage />
            </Grid>

        </Grid>

        <!-- 遮罩用 Border（无 hover 视觉态）：Button 的 PointerOver 会让整块遮罩连带左侧一起变暗。 -->
        <Border Grid.RowSpan="2" Background="#59000000"
                Tapped="OnScrimTapped"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                AutomationProperties.Name="关闭设置" />
        <views:SettingsDrawer Grid.RowSpan="2" HorizontalAlignment="Right"
                              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}" />
    </Grid>
</Window>
