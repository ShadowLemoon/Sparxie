<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <UseXamlCompilerExecutable>false</UseXamlCompilerExecutable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;AnyCPU</Platforms>
    <ApplicationIcon>..\..\assets\sparxie.ico</ApplicationIcon>
    <!-- slnx 整体构建（如 CI）不带 Platform，自包含 WinAppSDK 需要明确架构。 -->
    <RuntimeIdentifier Condition="'$(Platform)' == 'AnyCPU' and '$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- 窗口图标（AppWindow.SetIcon）需要运行时能找到 ico 文件。 -->
    <Content Include="..\..\assets\sparxie.ico" Link="sparxie.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\sparxie-64.png" Link="sparxie-64.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\sparxie-256.png" Link="sparxie-256.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sparxie.Contracts\Sparxie.Contracts.csproj" />
    <ProjectReference Include="..\Sparxie.Infrastructure\Sparxie.Infrastructure.csproj" />
    <ProjectReference Include="..\Sparxie.LauncherCore\Sparxie.LauncherCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251106002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
  </ItemGroup>
</Project>
