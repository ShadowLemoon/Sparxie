<Page
    x:Class="Sparxie.Desktop.Views.ProfileManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnSpacing="16" Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="12">
            <Button Content="+ 新建 Profile" MinHeight="56" />
            <ListView>
                <ListViewItem Content="国服" />
                <ListViewItem Content="国际服" />
            </ListView>
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="12">
                <TextBlock Text="Profile 编辑" FontSize="28" />
                <TextBox Header="名称" Text="国服" />
                <TextBox Header="游戏路径" />
                <ToggleSwitch Header="FPS 解锁" />
                <NumberBox Header="目标 FPS" Value="144" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
