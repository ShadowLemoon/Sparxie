<Page
    x:Class="Sparxie.Desktop.Views.ProfileManagerPage"
    x:Name="ProfileRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sparxie.Desktop.ViewModels">
    <Page.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="NumberField" TargetType="NumberBox">
            <Setter Property="Width" Value="110" />
            <Setter Property="SpinButtonPlacementMode" Value="Compact" />
            <!-- 输入非法或清空时自动回退到上一个有效值，避免 Value 变成 NaN 传入域层。 -->
            <Setter Property="ValidationMode" Value="InvalidInputOverwritten" />
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="20,4,16,4">
            <TextBlock Text="Profile 管理" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="4,0,0,0" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="20" Padding="20,8,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="全部 Profile" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Width="36" Height="36" Padding="0" Command="{Binding Profiles.NewCommand}"
                                ToolTipService.ToolTip="新建 Profile" AutomationProperties.Name="新建 Profile">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>
                        <Button Width="36" Height="36" Padding="0" Command="{Binding Profiles.DeleteCommand}"
                                ToolTipService.ToolTip="删除所选 Profile" AutomationProperties.Name="删除所选 Profile">
                            <FontIcon Glyph="&#xE738;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" CornerRadius="8" Padding="4"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <ListView ItemsSource="{Binding Profiles.Profiles}"
                              SelectedItem="{Binding Profiles.SelectedProfile, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileEditorViewModel">
                                <StackPanel Padding="8" Spacing="3">
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Game, Converter={StaticResource GameDisplayConverter}, Mode=OneWay}" Opacity="0.65" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <Border Grid.Column="1" CornerRadius="8"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="20,16,20,12">
                        <TextBlock Text="Profile 详情" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="保存修改" Command="{Binding DataContext.Profiles.SaveCommand, ElementName=ProfileRoot}"
                                HorizontalAlignment="Right" MinHeight="36" MinWidth="104" />
                    </Grid>

                    <InfoBar Grid.Row="1" Margin="20,0,20,12" IsOpen="{Binding Profiles.HasStatus}"
                             IsClosable="False" Severity="{Binding Profiles.StatusSeverity}"
                             Message="{Binding Profiles.StatusMessage}" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled"
                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,0,20,20" Spacing="12"
                                    DataContext="{Binding Profiles.SelectedProfile}"
                                    Visibility="{Binding DataContext.Profiles.HasSelection, ElementName=ProfileRoot, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border Style="{StaticResource SectionCard}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="基本信息" Style="{StaticResource SectionTitle}" />
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="170" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding DisplayName, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="游戏" Style="{StaticResource FieldLabel}" />
                                        <!-- ItemsSource 必须是脱离 DataContext 的静态集合。若改回 {Binding Games}，
                                             切换 Profile 时集合实例会随 DataContext 变化，SelectedItem 因不在新集合中被置空，
                                             再经 TwoWay 把 default(GameType)（即 Genshin）写回数据，表现为下拉框漂移。 -->
                                        <ComboBox Grid.Column="3" ItemsSource="{x:Bind vm:ProfileEditorViewModel.GameOptions}" SelectedItem="{Binding Game, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" MinWidth="150">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource GameDisplayConverter}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Profile ID" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding Id, Mode=TwoWay}" IsEnabled="{Binding IsNew}" />
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="游戏 EXE" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding ExecutablePath, Mode=TwoWay}" />
                                        <Button Grid.Column="2" Content="浏览" MinWidth="88" MinHeight="32"
                                                Click="BrowseExecutableClick"
                                                AutomationProperties.Name="浏览游戏 EXE 路径"
                                                ToolTipService.ToolTip="选择游戏 EXE 文件" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}"
                                Visibility="{Binding IsHoyoGame, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="运行设置" Style="{StaticResource SectionTitle}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="FPS 解锁" Style="{StaticResource FieldLabel}" />
                                    <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" MinWidth="44"
                                                  IsOn="{Binding FpsUnlockEnabled, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="目标 FPS" Style="{StaticResource FieldLabel}" />
                                    <NumberBox Grid.Column="1" Style="{StaticResource NumberField}" Minimum="10" Maximum="1000"
                                               Value="{Binding TargetFps, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="3" Text="后台 FPS" Style="{StaticResource FieldLabel}" />
                                    <NumberBox Grid.Column="4" Style="{StaticResource NumberField}" Minimum="10" Maximum="1000"
                                               Value="{Binding BackgroundFps, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="后台 FPS 限制" Style="{StaticResource FieldLabel}" />
                                    <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" MinWidth="44"
                                                  IsOn="{Binding BackgroundFpsLimitEnabled, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="进程优先级" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Bind vm:ProfileEditorViewModel.PriorityOptions}" SelectedItem="{Binding ProcessPriority, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource PriorityDisplayConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}"
                                Visibility="{Binding IsGenshin, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="原神专属" Style="{StaticResource SectionTitle}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="跟随游戏内帧率预设" Style="{StaticResource FieldLabel}" />
                                    <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" MinWidth="44"
                                                  IsOn="{Binding GenshinFollowInGamePreset, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="30 FPS 预设" Style="{StaticResource FieldLabel}" />
                                    <NumberBox Grid.Column="1" Style="{StaticResource NumberField}" Minimum="10" Maximum="1000"
                                               Value="{Binding GenshinPreset30Fps, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="3" Text="60 FPS 预设" Style="{StaticResource FieldLabel}" />
                                    <NumberBox Grid.Column="4" Style="{StaticResource NumberField}" Minimum="10" Maximum="1000"
                                               Value="{Binding GenshinPreset60Fps, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="触控 UI 缩放覆盖" Style="{StaticResource FieldLabel}" />
                                    <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" MinWidth="44"
                                                  IsOn="{Binding GenshinTouchUiScaleOverrideEnabled, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="缩放 (%)" Style="{StaticResource FieldLabel}" />
                                    <NumberBox Grid.Column="1" Style="{StaticResource NumberField}" Minimum="100" Maximum="500"
                                               Value="{Binding GenshinTouchUiScalePercent, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
