<Page
    x:Class="Sparxie.Desktop.Views.ProfileManagerPage"
    x:Name="ProfileRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sparxie.Desktop.ViewModels"
    xmlns:controls="using:Sparxie.Desktop.Controls">
    <Page.Resources>
        <!-- 输入控件：字号放大并垂直居中（默认文字贴在左上）。 -->
        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="12,12,12,10" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource GlassStrokeBrush}" />
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题行：标题 + （多配置时）横向配置切换 + 更多菜单。单配置时只有标题和 ⋯。 -->
        <Grid Padding="24,4,20,4" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- 返回放在页面内容里（不在标题栏）：带文字的玻璃胶囊，44px 高，好点。 -->
                <Button Height="44" MinWidth="88" Padding="14,0" CornerRadius="22" Command="{Binding ShowHomeCommand}"
                        Background="{StaticResource GlassOverlayBrush}"
                        BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1"
                        ToolTipService.ToolTip="返回主页" AutomationProperties.Name="返回主页">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                        <TextBlock Text="返回" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Profiles.ScopeTitle}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <ListView Grid.Column="1" SelectionMode="Single" VerticalAlignment="Center" MinHeight="48"
                      ItemsSource="{Binding Profiles.Profiles}"
                      SelectedItem="{Binding Profiles.SelectedProfile, Mode=TwoWay}"
                      ScrollViewer.HorizontalScrollMode="Enabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      Visibility="{Binding Profiles.HasMultiple, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProfileEditorViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button MinHeight="48" Padding="16,0" Click="AddProfileClick"
                        AutomationProperties.Name="添加配置" ToolTipService.ToolTip="为这个游戏添加另一套配置（如其他服务器）">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="添加配置" />
                    </StackPanel>
                </Button>
                <!-- 更多：删除放在这里，只有存在多套配置时才出现，避免误触也不占表单位置。 -->
                <Button Width="48" Height="48" Padding="0"
                        AutomationProperties.Name="更多" ToolTipService.ToolTip="更多"
                        Visibility="{Binding Profiles.HasMultiple, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="删除当前配置" Click="DeleteProfileClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 内容面板：全程 Stretch，两栏固定 380 | *，宽度只由窗口决定。操作条叠在底部，不占行。 -->
        <Grid Grid.Row="1" Padding="20,0,20,20">
            <Border CornerRadius="{StaticResource PanelRadius}"
                    Background="{StaticResource GlassPanelBrush}"
                    BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled"
                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding Profiles.HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid DataContext="{Binding Profiles.SelectedProfile}">
                        <Grid ColumnSpacing="16" Padding="20,20,20,96"
                              Visibility="{Binding IsHoyoGame, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 左栏：游戏在哪、怎么启动 -->
                            <StackPanel Spacing="16" VerticalAlignment="Top">
                                <Border Style="{StaticResource GlassCard}">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="游戏" Style="{StaticResource SectionHeading}" />
                                        <TextBox Header="名称" MinHeight="48" Text="{Binding DisplayName, Mode=TwoWay}"
                                                 Visibility="{Binding DataContext.Profiles.ShowProfileName, ElementName=ProfileRoot, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Header="游戏 EXE" MinHeight="48" Text="{Binding ExecutablePath, Mode=TwoWay}" />
                                            <Button Grid.Column="1" Width="48" Height="48" Padding="0" VerticalAlignment="Bottom"
                                                    Click="BrowseExecutableClick"
                                                    AutomationProperties.Name="浏览游戏 EXE 路径"
                                                    ToolTipService.ToolTip="选择游戏 EXE 文件">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                            </Button>
                                        </Grid>
                                        <ComboBox Header="进程优先级" HorizontalAlignment="Stretch" MinHeight="48"
                                                  Visibility="{Binding IsHoyoGame, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  ItemsSource="{x:Bind vm:ProfileEditorViewModel.PriorityOptions}"
                                                  SelectedItem="{Binding ProcessPriority, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource PriorityDisplayConverter}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GlassCard}"
                                        Visibility="{Binding IsGenshin, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid ColumnSpacing="12" MinHeight="72">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="触控 UI 缩放" />
                                            <TextBlock Text="覆盖游戏内缩放，100–500%" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                                      VerticalAlignment="Center"
                                                      IsOn="{Binding GenshinTouchUiScaleOverrideEnabled, Mode=TwoWay}"
                                                      AutomationProperties.Name="启用触控 UI 缩放覆盖" />
                                        <controls:NumberStepper Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Right"
                                                                Margin="0,8,0,0" Minimum="100" Maximum="500" Step="5"
                                                                IsEnabled="{Binding GenshinTouchUiScaleOverrideEnabled}"
                                                                Value="{Binding GenshinTouchUiScalePercent, Mode=TwoWay}" />
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- 右栏：帧率。开关与数值合成一行；关闭时只禁用数值，不改变尺寸。 -->
                            <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="20,12" VerticalAlignment="Top"
                                    Visibility="{Binding IsHoyoGame, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="帧率" Style="{StaticResource SectionHeading}" Margin="0,4,0,8" />

                                    <Grid ColumnSpacing="16" MinHeight="72">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="目标帧率" />
                                            <TextBlock Text="解锁游戏帧率上限，10–1000" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center"
                                                      IsOn="{Binding FpsUnlockEnabled, Mode=TwoWay}"
                                                      AutomationProperties.Name="启用 FPS 解锁" />
                                        <controls:NumberStepper Grid.Column="2" VerticalAlignment="Center"
                                                                Minimum="10" Maximum="1000" Step="1"
                                                                IsEnabled="{Binding FpsUnlockEnabled}"
                                                                Value="{Binding TargetFps, Mode=TwoWay}" />
                                    </Grid>
                                    <Border Style="{StaticResource RowDivider}" />

                                    <Grid ColumnSpacing="16" MinHeight="72">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="后台帧率" />
                                            <TextBlock Text="窗口失去焦点时限制帧率，10–1000" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center"
                                                      IsOn="{Binding BackgroundFpsLimitEnabled, Mode=TwoWay}"
                                                      AutomationProperties.Name="启用后台帧率限制" />
                                        <controls:NumberStepper Grid.Column="2" VerticalAlignment="Center"
                                                                Minimum="10" Maximum="1000" Step="1"
                                                                IsEnabled="{Binding BackgroundFpsLimitEnabled}"
                                                                Value="{Binding BackgroundFps, Mode=TwoWay}" />
                                    </Grid>

                                    <StackPanel Visibility="{Binding IsGenshin, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border Style="{StaticResource RowDivider}" />
                                        <Grid ColumnSpacing="16" MinHeight="72">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="帧率档位映射" />
                                                <TextBlock Text="跟随游戏内 30 / 60 帧档位" Style="{StaticResource CaptionText}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" MinWidth="0" OnContent="" OffContent="" VerticalAlignment="Center"
                                                          IsOn="{Binding GenshinFollowInGamePreset, Mode=TwoWay}"
                                                          AutomationProperties.Name="跟随游戏内帧率档位" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="30 档" Style="{StaticResource CaptionText}" />
                                                <controls:NumberStepper Minimum="10" Maximum="1000" Step="1"
                                                                        IsEnabled="{Binding GenshinFollowInGamePreset}"
                                                                        Value="{Binding GenshinPreset30Fps, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="60 档" Style="{StaticResource CaptionText}" />
                                                <controls:NumberStepper Minimum="10" Maximum="1000" Step="1"
                                                                        IsEnabled="{Binding GenshinFollowInGamePreset}"
                                                                        Value="{Binding GenshinPreset60Fps, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 无帧率参数的游戏（绝区零）：单张卡铺满，名称与路径并排，不留右半空白。 -->
                        <Border Style="{StaticResource GlassCard}" Margin="20,20,20,96" VerticalAlignment="Top"
                                Visibility="{Binding IsHoyoGame, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <StackPanel Spacing="16">
                                <TextBlock Text="游戏" Style="{StaticResource SectionHeading}" />
                                <TextBox Header="名称" Text="{Binding DisplayName, Mode=TwoWay}"
                                         Visibility="{Binding DataContext.Profiles.ShowProfileName, ElementName=ProfileRoot, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Header="游戏 EXE" Text="{Binding ExecutablePath, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Width="48" Height="48" Padding="0" VerticalAlignment="Bottom"
                                            Click="BrowseExecutableClick"
                                            AutomationProperties.Name="浏览游戏 EXE 路径"
                                            ToolTipService.ToolTip="选择游戏 EXE 文件">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                    </ScrollViewer>

                    <!-- 自动保存失败等提示：平时不出现，只在有状态消息时吸底显示。 -->
                    <InfoBar VerticalAlignment="Bottom" Margin="12" IsClosable="False"
                             IsOpen="{Binding Profiles.HasStatus}"
                             Severity="{Binding Profiles.StatusSeverity}"
                             Message="{Binding Profiles.StatusMessage}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
