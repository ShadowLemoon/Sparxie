<UserControl
    x:Class="Sparxie.Desktop.Views.SettingsDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="480" CornerRadius="20,0,0,20"
            Background="{StaticResource GlassPanelBrush}"
            BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1,0,0,0">
        <Grid Padding="28,76,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="应用设置" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="改动即时生效，自动保存" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <Button Grid.Column="1" Width="48" Height="48" Command="{Binding CloseSettingsCommand}"
                        ToolTipService.ToolTip="关闭" AutomationProperties.Name="关闭设置">
                    <FontIcon Glyph="&#xE711;" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,28,0,20">
                <StackPanel Spacing="20">
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="8">
                            <ComboBox Header="点击关闭按钮时" HorizontalAlignment="Stretch" MinHeight="48"
                                      SelectedIndex="{Binding Settings.CloseBehaviorIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="退出前确认" />
                                <ComboBoxItem Content="最小化到系统托盘" />
                                <ComboBoxItem Content="直接退出" />
                            </ComboBox>
                            <TextBlock Text="选择托盘后，关闭窗口会隐藏到任务栏右下角的托盘图标；左键单击图标恢复，右键菜单里可退出。" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="8">
                            <ComboBox Header="游戏启动后" HorizontalAlignment="Stretch" MinHeight="48"
                                      SelectedIndex="{Binding Settings.AfterLaunchIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="保持窗口不变" />
                                <ComboBoxItem Content="最小化主窗口" />
                            </ComboBox>
                            <TextBlock Text="游戏进入运行状态后再生效；启动失败时不会最小化。" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="4">
                            <ToggleSwitch Header="调试模式" IsOn="{Binding Settings.DebugMode, Mode=TwoWay}" />
                            <TextBlock Text="在主页显示启动与注入状态条，便于排查问题；也可用环境变量 SPARXIE_DEBUG=1 开启。" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="数据与诊断" Style="{StaticResource SectionHeading}" />
                            <Button Content="打开配置目录" HorizontalAlignment="Stretch" MinHeight="48" Command="{Binding Settings.OpenDataFolderCommand}" />
                            <Button Content="打开日志目录" HorizontalAlignment="Stretch" MinHeight="48" Command="{Binding Settings.OpenLogsFolderCommand}" />
                            <Button Content="导出脱敏诊断包" HorizontalAlignment="Stretch" MinHeight="48" Command="{Binding Settings.ExportDiagnosticsCommand}" />
                            <TextBlock Text="诊断包只含日志与环境信息，不含 config.json 和完整用户路径。" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding Settings.ToolMessage}" TextWrapping="Wrap"
                                       Visibility="{Binding Settings.HasToolMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="关于" Style="{StaticResource SectionHeading}" />
                            <Image x:Name="AboutIcon" Width="128" Height="128" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <TextBlock Text="Sparxie" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Settings.VersionText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                            <TextBlock Text="许可证、第三方声明（THIRD-PARTY-NOTICES.md）与 Runtime 声明（RUNTIME-NOTICE.md）位于程序目录。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            <Button Content="打开程序目录" HorizontalAlignment="Stretch" MinHeight="48" Command="{Binding Settings.OpenInstallFolderCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
