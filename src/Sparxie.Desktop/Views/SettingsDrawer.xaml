<UserControl
    x:Class="Sparxie.Desktop.Views.SettingsDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sparxie.Desktop.ViewModels">
    <Border Width="480" CornerRadius="20,0,0,20"
            Background="{StaticResource GlassPanelBrush}"
            BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1,0,0,0">
        <Grid Padding="28,76,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="应用设置" Style="{StaticResource PageTitle}" />
                </StackPanel>
                <Button Grid.Column="1" Width="48" Height="48" Command="{Binding CloseSettingsCommand}"
                        ToolTipService.ToolTip="关闭" AutomationProperties.Name="关闭设置">
                    <FontIcon Glyph="&#xE711;" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,28,0,20">
                <StackPanel Spacing="20">
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="8">
                            <ComboBox Header="点击关闭按钮时" HorizontalAlignment="Stretch" MinHeight="48"
                                      SelectedIndex="{Binding Settings.CloseBehaviorIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="退出前确认" />
                                <ComboBoxItem Content="最小化到系统托盘" />
                                <ComboBoxItem Content="直接退出" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="8">
                            <ComboBox Header="游戏启动后" HorizontalAlignment="Stretch" MinHeight="48"
                                      SelectedIndex="{Binding Settings.AfterLaunchIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="保持窗口不变" />
                                <ComboBoxItem Content="最小化主窗口" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="4">
                            <ToggleSwitch Header="调试模式" IsOn="{Binding Settings.DebugMode, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}" AllowDrop="True" DragOver="PluginDragOver" Drop="PluginDrop">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="第三方游戏插件" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0"
                                        Command="{Binding Settings.Plugins.OpenPluginsFolderCommand}"
                                        AutomationProperties.Name="打开插件文件夹" ToolTipService.ToolTip="打开插件文件夹">
                                    <FontIcon Glyph="&#xE838;" FontSize="16" />
                                </Button>
                                <Button Grid.Column="2" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0"
                                        Command="{Binding Settings.Plugins.RefreshCommand}"
                                        AutomationProperties.Name="刷新插件列表" ToolTipService.ToolTip="刷新插件列表">
                                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                </Button>
                            </Grid>
                            <TextBlock Text="插件未经审计，会以管理员权限运行。" TextWrapping="Wrap" Style="{StaticResource CaptionText}" />

                            <ItemsControl ItemsSource="{Binding Settings.Plugins.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PluginItemViewModel">
                                        <Border Margin="0,0,0,10" Padding="0" CornerRadius="14"
                                                Background="{StaticResource GlassAcrylicBrush}"
                                                BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="1" Spacing="8" Padding="14,12">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <!-- 状态徽标：图标 + 文字，颜色不是唯一信号。 -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                                            <Grid>
                                                                <FontIcon Glyph="{x:Bind StatusGlyph}" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                          Visibility="{x:Bind IsStatusSuccess, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <FontIcon Glyph="{x:Bind StatusGlyph}" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                          Visibility="{x:Bind IsStatusCaution, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <FontIcon Glyph="{x:Bind StatusGlyph}" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                          Visibility="{x:Bind IsStatusCritical, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <FontIcon Glyph="{x:Bind StatusGlyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                          Visibility="{x:Bind IsStatusNeutral, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            </Grid>
                                                            <TextBlock Text="{x:Bind Status}" FontSize="13" TextWrapping="Wrap" MaxWidth="170" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                               Visibility="{x:Bind HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <!-- 这个插件自己的操作结果（导入 / 启用 / 停用…）。 -->
                                                    <TextBlock Text="{x:Bind Notice}" TextWrapping="Wrap" FontSize="13"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               AutomationProperties.LiveSetting="Polite"
                                                               Visibility="{x:Bind HasNotice, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock Text="{x:Bind BlockReason}" TextWrapping="Wrap" FontSize="12"
                                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                               Visibility="{x:Bind HasBlockReason, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock Text="注册表改动尚未恢复：关闭游戏后，在“⋯”里恢复。" TextWrapping="Wrap" FontSize="12"
                                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                               Visibility="{x:Bind HasPendingBackup, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button Content="{x:Bind EnableLabel}" Command="{x:Bind EnableCommand}" MinHeight="40"
                                                                Style="{StaticResource AccentButtonStyle}"
                                                                Visibility="{x:Bind CanEnable, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <Button Width="40" Height="40" Padding="0" AutomationProperties.Name="更多操作" ToolTipService.ToolTip="更多操作">
                                                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                                                            <Button.Flyout>
                                                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                                    <MenuFlyoutItem Text="停用" Command="{x:Bind DisableCommand}" IsEnabled="{x:Bind CanDisable}"
                                                                                    Visibility="{x:Bind CanDisableVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    <MenuFlyoutItem Text="打开所在文件夹" Command="{x:Bind OpenFolderCommand}" />
                                                                    <MenuFlyoutItem Text="立即恢复注册表" Command="{x:Bind RestoreBackupCommand}"
                                                                                    Visibility="{x:Bind HasPendingBackup, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    <MenuFlyoutSeparator />
                                                                    <MenuFlyoutItem Text="删除…" Command="{x:Bind DeleteCommand}" IsEnabled="{x:Bind CanDelete}"
                                                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 没有对应条目的消息（例如导入失败）。 -->
                            <TextBlock Text="{Binding Settings.Plugins.Message}" TextWrapping="Wrap"
                                       Visibility="{Binding Settings.Plugins.ShowStandaloneMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Button Content="导入插件…" HorizontalAlignment="Stretch" MinHeight="48" AutomationProperties.Name="导入插件">
                                <Button.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem Text="从压缩包导入（.zip）" Click="ImportPluginZipClick" />
                                        <MenuFlyoutItem Text="从文件夹导入" Click="ImportPluginFolderClick" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="数据与诊断" Style="{StaticResource SectionHeading}" />
                            <Button Content="打开配置目录" HorizontalAlignment="Stretch" MinHeight="48" Command="{Binding Settings.OpenDataFolderCommand}" />
                            <Button Content="打开日志目录" HorizontalAlignment="Stretch" MinHeight="48" Command="{Binding Settings.OpenLogsFolderCommand}" />
                            <Button Content="导出诊断包" HorizontalAlignment="Stretch" MinHeight="48" Command="{Binding Settings.ExportDiagnosticsCommand}" />
                            <TextBlock Text="{Binding Settings.ToolMessage}" TextWrapping="Wrap"
                                       Visibility="{Binding Settings.HasToolMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="关于" Style="{StaticResource SectionHeading}" />
                            <Image x:Name="AboutIcon" Width="128" Height="128" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <TextBlock Text="Sparxie" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Settings.VersionText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
                            <Button Content="打开程序目录" HorizontalAlignment="Stretch" MinHeight="48" Command="{Binding Settings.OpenInstallFolderCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
