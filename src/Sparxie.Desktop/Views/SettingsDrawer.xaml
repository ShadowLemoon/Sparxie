<UserControl
    x:Class="Sparxie.Desktop.Views.SettingsDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="480" Background="#DD202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Margin="32" Spacing="12">
            <TextBlock Text="应用设置" FontSize="28" />
            <TextBlock Text="外观、启动器行为、数据与诊断" Opacity="0.7" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="32" Spacing="8">
            <Button Content="主题" MinHeight="56" />
            <Button Content="启动器行为" MinHeight="56" />
            <Button Content="数据与诊断" MinHeight="56" />
            <Button Content="关于 Sparxie" MinHeight="56" />
        </StackPanel>
    </Grid>
</UserControl>
