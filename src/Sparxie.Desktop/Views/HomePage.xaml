<Page
    x:Class="Sparxie.Desktop.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sparxie.Desktop.ViewModels">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Margin="28,0,28,28"
                    Visibility="{Binding IsHomeChromeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- 路径异常：EXE 未设置 / 找不到 / 不属于该游戏时提示，并直达当前游戏设置页。 -->
            <Border HorizontalAlignment="Right" Margin="0,0,0,12" Padding="16,8,8,8" CornerRadius="16" MaxWidth="720"
                    Background="{StaticResource GlassAcrylicBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1"
                    Visibility="{Binding Home.HasPathIssue, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock Text="{Binding Home.PathIssueMessage}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" />
                    <Button Content="定位游戏" MinHeight="48" Padding="16,0"
                            Command="{Binding ShowProfilesCommand}" AutomationProperties.Name="定位游戏" />
                </StackPanel>
            </Border>
            <!-- 启动状态条：启动/注入各阶段与失败原因（之前只写在内部状态里，界面上看不到）。 -->
            <Border HorizontalAlignment="Right" Margin="0,0,0,12" Padding="16,10" CornerRadius="16" MaxWidth="720"
                    Background="{StaticResource GlassAcrylicBrush}"
                    BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1"
                    Visibility="{Binding Home.HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding Home.StatusMessage}" TextWrapping="Wrap" FontSize="14" />
            </Border>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 游戏 + 配置合并切换：一张固定宽度的卡。左侧切换区点开 Flyout 选游戏（多配置的游戏下挂配置 Chip），右侧齿轮进入当前游戏设置。 -->
                <Border Width="380" Height="68" CornerRadius="20"
                        Background="{StaticResource GlassAcrylicBrush}"
                        BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="68" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="SwitcherButton" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" Padding="12,0,14,0"
                                CornerRadius="20,0,0,20" Background="Transparent" BorderThickness="0" Foreground="White"
                                AutomationProperties.Name="{Binding Home.SwitcherAutomationName}">
                            <Button.Flyout>
                                <Flyout x:Name="SwitcherFlyout" Placement="TopEdgeAlignedLeft">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Background" Value="{StaticResource GlassPanelBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
                                            <Setter Property="Padding" Value="8" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel Width="344" Spacing="2">
                                        <ItemsControl ItemsSource="{Binding Home.GameEntries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GameEntryViewModel">
                                                    <Border CornerRadius="14" Background="{x:Bind RowBackground}" Margin="0,0,0,2">
                                                    <StackPanel Spacing="4">
                                                        <Button Command="{x:Bind SelectCommand}"
                                                                MinHeight="56" Padding="12,0" CornerRadius="14"
                                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                Background="Transparent" BorderThickness="0"
                                                                AutomationProperties.Name="{x:Bind AutomationName}">
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Image Source="{x:Bind Icon}" Width="28" Height="28" />
                                                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="15" VerticalAlignment="Center"
                                                                           Foreground="{x:Bind TitleForeground}" />
                                                            </Grid>
                                                        </Button>
                                                        <ItemsControl ItemsSource="{x:Bind Profiles}" Margin="52,0,8,6"
                                                                      Visibility="{x:Bind HasMultipleProfiles, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ProfileChipViewModel">
                                                                    <Button Command="{x:Bind SelectCommand}"
                                                                            MinHeight="48" Padding="16,0" CornerRadius="24"
                                                                            Background="{x:Bind ChipBackground}"
                                                                            Foreground="{x:Bind ChipForeground}"
                                                                            BorderBrush="{StaticResource GlassStrokeBrush}" BorderThickness="1"
                                                                            AutomationProperties.Name="{x:Bind AutomationName}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <TextBlock Text="{x:Bind DisplayName}" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Home.CurrentGameIcon}" Width="40" Height="40" />
                                <TextBlock Grid.Column="1" Text="{Binding Home.SwitcherLabel}" FontSize="18" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <FontIcon Grid.Column="2" Glyph="&#xE70E;" FontSize="12" Opacity="0.7" />
                            </Grid>
                        </Button>

                        <Rectangle Grid.Column="1" Fill="{StaticResource GlassStrokeBrush}" Margin="0,12" />

                        <Button Grid.Column="2" Width="68" Height="68" Padding="0" CornerRadius="0,20,20,0"
                                Background="Transparent" BorderThickness="0" Foreground="White"
                                Command="{Binding ShowProfilesCommand}" ToolTipService.ToolTip="游戏设置"
                                AutomationProperties.Name="{Binding Home.GameSettingsAutomationName}">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 系统强调色按钮样式（悬停/按下由 SystemAccentColor 的亮/暗变体自动派生）+ 圆角 + 双箭头图标。 -->
                <Grid Grid.Column="2" Width="320" Height="68" CornerRadius="34"
                      Background="{StaticResource GlassOverlayBrush}">
                    <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            BorderThickness="0" CornerRadius="34" FontSize="22" FontWeight="Bold"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{Binding Home.LaunchCommand}"
                            AutomationProperties.Name="{Binding Home.LaunchAutomationName}">
                        <Button.Resources>
                            <StaticResource x:Key="AccentButtonBackground" ResourceKey="StartButtonBrush" />
                            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="StartButtonHoverBrush" />
                            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="StartButtonPressedBrush" />
                            <StaticResource x:Key="AccentButtonForeground" ResourceKey="StartButtonForegroundBrush" />
                            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="StartButtonForegroundBrush" />
                            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="StartButtonForegroundBrush" />
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="{Binding Home.LaunchLabel}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
