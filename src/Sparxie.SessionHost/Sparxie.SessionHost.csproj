<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sparxie.Contracts\Sparxie.Contracts.csproj" />
    <ProjectReference Include="..\Sparxie.Infrastructure\Sparxie.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- HoyoTouchCore.dll 上游 asm_syscall 手写汇编不兼容 CET shadow stack，
         在 CET 下 jmp/ret 触发 #CP → C0000409；SessionHost 必须禁用 CET。 -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>

</Project>
